{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/appointments/index.ts": {
      "includeFiles": "api/lib/gmail-smtp.cjs,api/templates/appointment-email.html",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/book-appointment", "destination": "/api/appointments" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
