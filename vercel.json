{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/book-appointment.ts": {
      "includeFiles": "api/lib/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/appointment-services.json", "destination": "/api/appointment-services.json" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
