{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/appointments/index.ts": {
      "includeFiles": "{api/templates/appointment-email.html,api/lib/appointments/**}",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
