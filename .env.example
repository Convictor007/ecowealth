# MySQL (XAMPP) — run database/schema.sql then: php database/seed.php
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecowealth
DB_USER=ecowealth
DB_PASS=ecowealth_pass

# React: load clinic + products from MySQL via PHP API (recommended on XAMPP)
VITE_USE_MYSQL_API=true
# VITE_API_BASE=http://localhost/ecowealth_v2/api/v1

# Booking API (saves to MySQL — no email)
# npm run dev: same-origin /api/appointments (Node + mysql2, uses DB_* above)
# VITE_APPOINTMENT_API_URL=/api/appointments
# XAMPP Apache:
# VITE_APPOINTMENT_API_URL=http://localhost/ecowealth_v2/api/appointments/book.php

CLINIC_NAME=Eco Wealth Wellnessolution

# Vercel API security (off by default)
# BOOKING_SECURITY_ENABLED=true
# RATE_LIMIT_SALT=generate-a-long-random-secret-here
# APPOINTMENT_RATE_LIMIT_PER_HOUR=5
