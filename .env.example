# Booking API (optional — default with npm run dev is same-origin /api/appointments)
# VITE_APPOINTMENT_API_URL=/api/appointments
# XAMPP only (if you prefer PHP instead of the Vite dev API):
# VITE_APPOINTMENT_API_URL=http://localhost/ecowealth_v2/api/appointments/book.php

# Clinic
CLINIC_NAME=Eco Wealth Wellnessolution
CLINIC_EMAIL=clinic-inbox@gmail.com

# --- Recommended for Vercel: Resend (HTTPS API, no SMTP ports) ---
# Sign up: https://resend.com — API key + verify your domain (or use onboarding@resend.dev for testing)
# MAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=appointments@your-verified-domain.com
MAIL_FROM_NAME=Eco Wealth Appointments

# --- Alternative: Gmail SMTP (works locally; often blocked on Vercel) ---
# MAIL_PROVIDER=smtp
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION=tls
MAIL_SMTP_USER=your-gmail@gmail.com
MAIL_SMTP_PASS=your-gmail-app-password
MAIL_FROM_EMAIL=your-gmail@gmail.com
MAIL_FROM_NAME=Eco Wealth Appointments

# Branded email (optional)
# EMAIL_TAGLINE=Natural Healing · Holistic Wellness · Trusted Care
# EMAIL_PRACTITIONER=Edgar Bustamante, N.D.
# EMAIL_PRACTITIONER_TITLE=Naturopathy Practitioner
# EMAIL_PHONES=0951 611 4125,0991 391 6469
# EMAIL_HOURS=Mon–Sat 9:00 AM – 6:00 PM · Sunday by appointment
# EMAIL_LOCATION=ONEWAYHI Health and Wellness, Bicol Region, Philippines

# Vercel API security (off by default — set to true when ready)
# BOOKING_SECURITY_ENABLED=true
# RATE_LIMIT_SALT=generate-a-long-random-secret-here
# APPOINTMENT_RATE_LIMIT_PER_HOUR=5
# XAMPP only: save JSON copies of requests (optional)
STORE_APPOINTMENTS=false
