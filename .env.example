# Frontend — LOCAL ONLY (do not set on Vercel)
# VITE_APPOINTMENT_API_URL=http://localhost/ecowealth_v2/api/appointments/index.php

# Clinic inbox (receives booking emails)
CLINIC_NAME=Eco Wealth Wellnessolution
CLINIC_EMAIL=your-clinic-inbox@gmail.com

# Gmail SMTP — use an App Password (not your normal Gmail password)
# 1. Google Account → Security → 2-Step Verification ON
# 2. App passwords → create "Mail" → copy 16-character password
# 3. MAIL_SMTP_USER = Gmail address that sends mail
# 4. MAIL_SMTP_PASS = 16-char app password (spaces optional)
MAIL_TRANSPORT=smtp
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION=tls
MAIL_SMTP_TIMEOUT=30
MAIL_SMTP_USER=your-gmail@gmail.com
MAIL_SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM_EMAIL=your-gmail@gmail.com
MAIL_FROM_NAME=Eco Wealth Appointments

# CORS (local + your Vercel URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,https://ecowealth-chi.vercel.app
STORE_APPOINTMENTS=true
