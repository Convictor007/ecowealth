# Copy to .env in project root (same folder as package.json)
# Vite only exposes variables prefixed with VITE_

# --- Frontend (Vite) ---
VITE_APPOINTMENT_API_URL=http://localhost/ecowealth_v2/api/appointments/index.php

# --- Clinic (PHP API — not exposed to the browser) ---
CLINIC_NAME=Eco Wealth Wellnessolution
CLINIC_EMAIL=your-inbox@gmail.com

# --- Mail (Gmail SMTP) ---
MAIL_TRANSPORT=smtp
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION=tls
MAIL_SMTP_TIMEOUT=30
MAIL_SMTP_USER=your-sender@gmail.com
MAIL_SMTP_PASS=your-gmail-app-password
MAIL_FROM_EMAIL=your-sender@gmail.com
MAIL_FROM_NAME=Eco Wealth Appointments

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost
STORE_APPOINTMENTS=true

# --- Appointment email branding (optional) ---
EMAIL_TAGLINE=Natural Healing · Holistic Wellness · Trusted Care
EMAIL_PRACTITIONER=Edgar Bustamante, N.D.
EMAIL_PRACTITIONER_TITLE=Naturopathy Practitioner
EMAIL_PHONES=0951 611 4125,0991 391 6469
EMAIL_HOURS=Mon–Sat 9:00 AM – 6:00 PM · Sunday by appointment
EMAIL_LOCATION=ONEWAYHI Health and Wellness, Bicol Region, Philippines
