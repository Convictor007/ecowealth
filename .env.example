# Frontend (Vite) — local XAMPP PHP API (optional on Vercel; production uses /api/appointments)
# VITE_APPOINTMENT_API_URL=http://localhost/ecowealth_v2/api/appointments/index.php

# Clinic
CLINIC_NAME=Eco Wealth Wellnessolution
CLINIC_EMAIL=your-clinic-inbox@example.com

# Mail (Gmail SMTP or your provider)
MAIL_TRANSPORT=smtp
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION=tls
MAIL_SMTP_TIMEOUT=30
MAIL_SMTP_USER=your-smtp-user@example.com
MAIL_SMTP_PASS=your-app-password
MAIL_FROM_EMAIL=your-smtp-user@example.com
MAIL_FROM_NAME=Eco Wealth Appointments

# API / CORS (add your Vercel URL on Vercel dashboard)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,https://ecowealth-chi.vercel.app
STORE_APPOINTMENTS=true
